{
  "manifest_version": 3,
  "name": "notme",
  "version": "1.7.0",
  "description": "Choose native or spoofed browser signals before each Anthropic visit; align location, timezone, language and browser identity.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "privacy",
    "tabs",
    "webNavigation",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "navigation_guard", "enabled": true, "path": "guard-rules.json" }]
  },
  "web_accessible_resources": [{ "resources": ["gate.html"], "matches": [
    "*://*.anthropic.com/*", "*://*.claude.ai/*", "*://*.claude.com/*", "*://*.claude.app/*",
    "*://*.claudeusercontent.com/*", "*://*.claudemcpcontent.com/*", "*://*.claude.site/*"
  ] }],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/timezone.js",
        "lib/identity.js",
        "content-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "notme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/xming521/notme"
}
