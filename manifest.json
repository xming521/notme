{
  "manifest_version": 3,
  "name": "notme",
  "version": "1.8.12",
  "key": "",
  "description": "Choose native or spoofed browser signals before each Anthropic visit; align location, timezone, language and browser identity.",
  "minimum_chrome_version": "119",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest",
    "privacy",
    "tabs",
    "webNavigation",
    "browsingData",
    "declarativeNetRequestFeedback",
    "notifications"
  ],
  "host_permissions": [
    "*://*.anthropic.com/*",
    "*://*.claude.ai/*",
    "*://*.claude.com/*",
    "*://*.claude.app/*",
    "*://*.claudeusercontent.com/*",
    "*://*.claudemcpcontent.com/*",
    "*://*.claude.site/*",
    "https://reallyfreegeoip.org/*",
    "https://ipwho.is/*",
    "https://ipapi.co/*",
    "https://ipinfo.io/*",
    "https://overpass-api.de/*",
    "https://overpass.kumi.systems/*",
    "https://maps.mail.ru/*",
    "https://api.bigdatacloud.net/*",
    "https://cloudflare-quic.com/*",
    "*://fuck-claude.vercel.app/*",
    "*://fuck-claude.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "navigation_guard",
        "enabled": true,
        "path": "guard-rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "gate.html"
      ],
      "matches": [
        "*://*.anthropic.com/*",
        "*://*.claude.ai/*",
        "*://*.claude.com/*",
        "*://*.claude.app/*",
        "*://*.claudeusercontent.com/*",
        "*://*.claudemcpcontent.com/*",
        "*://*.claude.site/*",
        "*://fuck-claude.vercel.app/*",
        "*://fuck-claude.app/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.anthropic.com/*",
        "*://*.claude.ai/*",
        "*://*.claude.com/*",
        "*://*.claude.app/*",
        "*://*.claudeusercontent.com/*",
        "*://*.claudemcpcontent.com/*",
        "*://*.claude.site/*",
        "*://fuck-claude.vercel.app/*",
        "*://fuck-claude.app/*"
      ],
      "js": [
        "lib/timezone.js",
        "lib/identity.js",
        "content-inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "*://*.anthropic.com/*",
        "*://*.claude.ai/*",
        "*://*.claude.com/*",
        "*://*.claude.app/*",
        "*://*.claudeusercontent.com/*",
        "*://*.claudemcpcontent.com/*",
        "*://*.claude.site/*",
        "*://fuck-claude.vercel.app/*",
        "*://fuck-claude.app/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "notme",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "gate.html?settings",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/xming521/notme"
}
